[Unit]
Description=Remove expired Splyto live locations
After=mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/splyto
ExecStart=/usr/bin/php /var/www/splyto/scripts/run_live_location_cleanup.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The admin System page reads job heartbeats from here (scripts/README.md).
ReadWritePaths=/var/lib/splyto/status
