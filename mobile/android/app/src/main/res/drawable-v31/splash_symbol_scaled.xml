<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ scales this icon up and clips it to a circle, so the wide logo has to
     stay this small to keep its first and last letters. Checked on an API 36 emulator. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/launch_symbol"
        android:gravity="center"
        android:height="39dp"
        android:width="100dp" />
</layer-list>
